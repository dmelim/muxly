{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muxly",
  "version": "0.5.1-mac-alpha.1",
  "identifier": "com.diethos.muxly",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Muxly",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Diethos",
    "homepage": "https://muxly.diethos.com",
    "copyright": "Copyright © 2026 Diethos",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../services.sample.json"
    ]
  }
}
